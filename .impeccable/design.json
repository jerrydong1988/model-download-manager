      "html": "<button class=\"ds-btn-primary\">开始下载</button>",
      "css": ".ds-btn-primary{height:36px;padding:0 14px;border-radius:8px;border:1px solid rgb(8 106 74 / 0.25);background:rgb(236 253 245);color:rgb(8 106 74);font-size:14px;font-weight:500;}.ds-btn-primary:hover{border-color:rgb(8 106 74 / 0.4);background:rgb(8 106 74 / 0.1);}.ds-btn-primary:focus-visible{outline:2px solid rgb(64 93 230);outline-offset:2px;}"
