  "narrative": {
    "northStar": "浅灰目录",
    "overview": "浅灰窗口、白色工作面和少量深薄荷绿，组成清楚的桌面模型目录。布局仍是侧栏四页加工作区：浏览仓库、下载队列、本地模型库、设置。精致感来自对齐、细分隔线和把绿色只用在当前项、主操作与进度上。\n\nv0.4.2 用这套配色替换雾白图录的蓝紫强调。用户保留原来的信息目录和操作，不接受整页矿物绿，也不接受把壳子改成另一种产品的布局。导航和短暂浮层继续用轻半透明；内容面保持实色。Windows 原生字体不变，不仿窗口装饰，也不引入专有字体。",
    "keyCharacteristics": [
      "浅灰窗口与白色工作面，深薄荷绿只标出当前项、主操作和进度。",
      "四页目录、字阶、圆角和轻玻璃导航保持不变。",
      "焦点环使用靛蓝，不跟强调色走。",
      "浅色与深色共用角色名；深色把薄荷绿提亮，以保证文字对比。"
    ],
    "rules": [
      {
        "name": "The Ink Not Fill Rule",
        "body": "薄荷绿用于文字、图标、细边和浅底。浅色主按钮是 primary-soft 底加 primary 字，不是实心 primary 配白字。纯色 #10b981 配白字对比不足，不作为填充。",
        "section": "colors"
      },
      {
        "name": "The Focus Is Indigo Rule",
        "body": "键盘焦点使用 ring，浅色 rgb(64 93 230)，深色 rgb(123 147 255)。不要把焦点环改成薄荷绿。",
        "section": "colors"
      },
      {
        "name": "The Readable Hierarchy Rule",
        "body": "名称先于元数据；最小文字使用 meta 字阶，数字对齐，路径和文件名使用等宽字体。",
        "section": "typography"
      },
      {
        "name": "The Same Shell Rule",
        "body": "可以更换配色和控件着色，不改四页导航、顶栏、状态栏和浏览、选择、下载的顺序。",
        "section": "layout"
      },
      {
        "name": "The Flat Content, Light Glass Rule",
        "body": "内容保持平面。轻玻璃用于导航和浮层。阴影用于当前导航项、浮层、提示和辅助内容。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用语义令牌和共享组件，并同时核对浅色与深色。",
      "Do 把薄荷绿用在当前图标、浅底主按钮、进度和已选择的操作栏上。",
      "Do 用靛蓝焦点环、可见状态文字和图标按钮名称保持可访问性。",
      "Do 保持四页壳、顶栏主题按钮和设置里的三态主题一致。"
    ],
    "donts": [
      "Don't 恢复雾白图录的蓝紫主色，或把矿物绿铺成整页背景。",
      "Don't 用实心 #10b981 配白字做主按钮，或把焦点环改成绿色。",
      "Don't 把当前导航画成整条实心色，或改掉四页布局和下载流程。",
      "Don't 使用低于 12px 的文字、装饰性显示字体或 emoji 图标。",
      "Don't 把 v0.4.2 之前的截图或旧规范当作当前配色依据。"
    ]
  }
}
