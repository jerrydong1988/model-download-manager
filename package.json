{
  "name": "model-download-manager",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "ModelScope / HuggingFace 模型下载管理器",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:types": "tsc --noEmit",
    "check:public": "node scripts/check-public-content.mjs",
    "test:frontend": "node --test tests/frontend/*.test.ts",
    "check:ui": "node scripts/check-contrast.mjs && node scripts/check-ui-rules.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons": "node scripts/gen-icons.mjs",
    "check:icons": "node scripts/check-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
